rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Функция проверки белого списка мастеров
    function isAllowedMaster() {
      return request.auth != null
        && request.auth.token.email in [
          'vladhrapko@gmail.com'
        ];
    }

    // Правила безопасности для коллекции учета рабочего времени
    match /work_entries/{entryId} {
      allow read: if true;
      allow create: if isAllowedMaster();
      allow update: if isAllowedMaster();
      allow delete: if isAllowedMaster();
    }

    // Правила безопасности для коллекции смен
    match /work_shifts/{shiftId} {
      allow read: if true;
      allow create: if isAllowedMaster();
      allow update: if isAllowedMaster();
      allow delete: if isAllowedMaster();
    }

    // Запрет всех остальных коллекций по умолчанию
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
